. /etc/rc.subr

name="ostftpproxy"
rcvar="os_tftp_proxy_enable"

load_rc_config os-tftp-proxy

: ${os_tftp_proxy_enable:="NO"}

start_cmd="tftpproxy_start"
stop_cmd="tftpproxy_stop"
restart_cmd="tftpproxy_restart"
status_cmd="tftpproxy_status"
extra_commands="reload"
reload_cmd="tftpproxy_reload"

INETD_CONF="/etc/inetd.conf.d/tftp-proxy"
INETD_MAIN_CONF="/etc/inetd.conf"

# inetd(8) only reads /etc/inetd.conf.d/* if /etc/inetd.conf includes it, and
# the base system does not enable/run inetd by default. Make sure both are
# true before relying on inetd to pick up our config.
tftpproxy_ensure_inetd()
{
    if [ ! -f "${INETD_MAIN_CONF}" ]; then
        echo "${INETD_MAIN_CONF} not found" >&2
        return 1
    fi

    if ! grep -Eq '^[[:space:]]*includedir[[:space:]]+/etc/inetd\.conf\.d([[:space:]]|$)' "${INETD_MAIN_CONF}"; then
        if ! printf '\nincludedir /etc/inetd.conf.d\n' >> "${INETD_MAIN_CONF}"; then
            echo "Failed to add includedir directive to ${INETD_MAIN_CONF}" >&2
            return 1
        fi
    fi

    if ! /usr/sbin/sysrc -q inetd_enable=YES > /dev/null; then
        echo "Failed to persist inetd_enable=YES" >&2
        return 1
    fi

    inetd_pid=""
    if [ -f /var/run/inetd.pid ]; then
        inetd_pid="$(cat /var/run/inetd.pid)"
    fi

    if [ -n "${inetd_pid}" ] && kill -0 "${inetd_pid}" 2>/dev/null; then
        if ! kill -HUP "${inetd_pid}"; then
            echo "Failed to HUP running inetd" >&2
            return 1
        fi
    else
        if ! /etc/rc.d/inetd onestart; then
            echo "Failed to start inetd" >&2
            return 1
        fi
    fi
}

tftpproxy_start()
{
    if [ ! -f "${INETD_CONF}" ]; then
        echo "tftp-proxy inetd config not found: ${INETD_CONF}"
        return 1
    fi
    if ! tftpproxy_ensure_inetd; then
        return 1
    fi
    echo "tftp-proxy started (via inetd)"
}

tftpproxy_stop()
{
    # Remove the inetd config so it does not re-activate on reload, then HUP
    # inetd to flush the service entry.
    if [ -f "${INETD_CONF}" ]; then
        rm -f "${INETD_CONF}"
    fi
    if [ -f /var/run/inetd.pid ]; then
        kill -HUP "$(cat /var/run/inetd.pid)"
    fi
    # Terminate any running tftp-proxy worker processes
    pkill -f /usr/libexec/tftp-proxy || true
    echo "tftp-proxy stopped"
}

tftpproxy_restart()
{
    # Kill any running worker and re-HUP inetd without touching INETD_CONF,
    # since tftpproxy_stop removes it and tftpproxy_start requires it to
    # exist; by the time restart runs, the config has already been
    # regenerated to reflect the desired state.
    pkill -f /usr/libexec/tftp-proxy || true
    tftpproxy_start
}

tftpproxy_reload()
{
    tftpproxy_start
}

tftpproxy_status()
{
    if pgrep -f /usr/libexec/tftp-proxy > /dev/null 2>&1; then
        echo "tftp-proxy is running"
        return 0
    else
        echo "tftp-proxy is not running (inetd-managed, starts on-demand)"
        return 1
    fi
}

run_rc_command "$1"
